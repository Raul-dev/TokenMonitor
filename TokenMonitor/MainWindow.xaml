<Window x:Class="TokenMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokenMonitor"
        Title="Token Monitor — расход токенов"
        Height="820" Width="1240" MinHeight="560" MinWidth="980"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E6EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,2,0,1" />
        </Style>
        <Style x:Key="CardDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8A8F98" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E6EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SourceComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Token Monitor" FontSize="17" FontWeight="SemiBold" Foreground="#111827" />
                    <Border Background="#F3F4F6" CornerRadius="8" Padding="2" Margin="0,6,0,4" HorizontalAlignment="Left">
                        <ComboBox x:Name="SourceComboBox" Width="120" Height="28" Style="{StaticResource SourceComboBox}"
                                  ItemsSource="{Binding Providers}"
                                  DisplayMemberPath="Key"
                                  SelectedValuePath="Value"
                                  SelectionChanged="SourceComboBox_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <!-- Магия здесь: берём IsEnabled из структуры ProviderConfig (Value) -->
                                    <Setter Property="IsEnabled" Value="{Binding Value.IsEnabled}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Border>
                    <TextBlock x:Name="DbPathText" FontSize="10" Foreground="#8A8F98" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="BudgetText" FontSize="24" FontWeight="SemiBold" Foreground="#111827"
                               HorizontalAlignment="Center" Text="—" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="BudgetDetail" FontSize="11" Foreground="#6B7280" Text="" />
                        <TextBlock FontSize="11" Foreground="#C3C7CD" Text="  ·  " />
                        <TextBlock FontSize="11">
                            <Hyperlink x:Name="ConfigLink" Click="ConfigLink_Click" Foreground="#2563EB">конфиг</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Orientation="Vertical">
                        <Button x:Name="RefreshButton" Content="Обновить" Padding="14,5" Click="RefreshButton_Click" />
                        <TextBlock FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Hyperlink x:Name="SourceConfigLink" Click="SourceConfigLink_Click" Foreground="#2563EB">конфиг</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="16,12,6,8">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ЗА МЕСЯЦ" />
                    <TextBlock x:Name="MonthTotal" Style="{StaticResource CardValue}" Text="—" />
                    <TextBlock x:Name="MonthDetail" Style="{StaticResource CardDetail}" Text="" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ЗА ДЕНЬ" />
                    <TextBlock x:Name="DayTotal" Style="{StaticResource CardValue}" Text="—" />
                    <TextBlock x:Name="DayDetail" Style="{StaticResource CardDetail}" Text="" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ЗА СЕССИЮ" />
                    <TextBlock x:Name="SessionTotal" Style="{StaticResource CardValue}" Text="—" />
                    <TextBlock x:Name="SessionDetail" Style="{StaticResource CardDetail}" Text="" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ЗА ЗАПРОС" />
                    <TextBlock x:Name="RequestTotal" Style="{StaticResource CardValue}" Text="—" />
                    <TextBlock x:Name="RequestDetail" Style="{StaticResource CardDetail}" Text="" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="СЕССИИ / ЗАПРОСЫ / ШАГИ" Style="{StaticResource HeaderCell}" HorizontalAlignment="Left" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="1" Text="ТОКЕНЫ" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="2" Text="ВХОД" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="3" Text="ВЫХОД" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="4" Text="REASONING" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="5" Text="КЭШ" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="6" Text="ЗАПР/ШАГИ" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="7" Text="ВРЕМЯ" Style="{StaticResource HeaderCell}" />
                        </Grid>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="TreeHint" Text="Кликните по сессии, чтобы увидеть детализацию. Правый клик — открыть сессию в OpenCode."
                               FontSize="10" Foreground="#8A8F98" Margin="12,6,12,8" />
                    <TreeView x:Name="SessionsTree"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="4,4,4,0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="SessionsTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="SessionsTree_PreviewMouseRightButtonDown">
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="SessionMenu" Opened="SessionMenu_Opened">
                                <MenuItem x:Name="OpenInAppItem" Header="Открыть в Windows OpenCode" Click="OpenInApp_Click"
                                          ToolTip="Поднимает окно OpenCode на этом проекте (сессию выбирает само приложение)" />
                                <Separator />
                                <MenuItem x:Name="ResumeTuiItem" Header="Открыть в терминале (эта сессия)" Click="ResumeTui_Click"
                                          ToolTip="Запускает opencode -s &lt;id&gt; в новом окне терминала" />
                                <MenuItem x:Name="ResumeForkItem" Header="Открыть в терминале копией (--fork)" Click="ResumeFork_Click"
                                          ToolTip="То же, но с --fork: оригинал не изменится" />
                                <Separator />
                                <MenuItem x:Name="CopySessionIdItem" Header="Скопировать ID сессии" Click="CopySessionId_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:SessionNode}" ItemsSource="{Binding Children}">
                                <Grid ToolTip="{Binding ExactText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8A8F98" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding InputText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="3" Text="{Binding OutputText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="4" Text="{Binding ReasoningText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="5" Text="{Binding CacheText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="6" Text="{Binding CountText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="7" Text="{Binding TimeText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#6B7280" />
                                </Grid>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type local:RequestNode}" ItemsSource="{Binding Children}">
                                <Grid ToolTip="{Binding ExactText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8A8F98" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding InputText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="3" Text="{Binding OutputText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="4" Text="{Binding ReasoningText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="5" Text="{Binding CacheText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="6" Text="{Binding CountText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#4B5563" />
                                    <TextBlock Grid.Column="7" Text="{Binding TimeText}" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="#6B7280" />
                                </Grid>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type local:StepNode}">
                                <Grid ToolTip="{Binding ExactText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding InputText}" FontSize="11" Foreground="#8A8F98" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding OutputText}" FontSize="11" Foreground="#8A8F98" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding ReasoningText}" FontSize="11" Foreground="#8A8F98" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding CacheText}" FontSize="11" Foreground="#8A8F98" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="6" Text="{Binding CountText}" FontSize="11" Foreground="#8A8F98" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="7" Text="{Binding TimeText}" FontSize="11" Foreground="#8A8F98" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#EDEFF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="ЖИВАЯ ЛЕНТА ЗАПРОСОВ" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280" />
                            <TextBlock x:Name="LivePathText" FontSize="10" Foreground="#8A8F98" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="Двойной клик по записи — переход к сессии в дереве."
                               FontSize="10" Foreground="#8A8F98" Margin="12,6,12,8" TextWrapping="Wrap" />
                    <ListView x:Name="LiveList" BorderThickness="0" Background="Transparent"
                              MouseDoubleClick="LiveList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Время" Width="58" DisplayMemberBinding="{Binding TimeText}" />
                                <GridViewColumn Header="Токены" Width="62" DisplayMemberBinding="{Binding BilledText}" />
                                <GridViewColumn Header="Длит." Width="58" DisplayMemberBinding="{Binding DurationText}" />
                                <GridViewColumn Header="Шаги" Width="42" DisplayMemberBinding="{Binding StepsText}" />
                                <GridViewColumn Header="Сессия" Width="140" DisplayMemberBinding="{Binding SessionText}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding ExactText}" />
                                <Setter Property="Padding" Value="2,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
