<Application x:Class="TokenMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TokenMonitor">
    <Application.Resources>
        <!-- Единый вид тултипов: перенос по словам и ограничение ширины.
             Application.Resources (а не Window.Resources) — потому что ToolTip
             живёт в отдельном popup и не наследует ресурсы окна. -->
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="720" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
